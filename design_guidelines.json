  "instructions_to_main_agent": [
    "Uygulamadaki tüm metinler, menü isimleri, butonlar, tablo başlıkları ve bildirimler %100 Türkçe olmalıdır.",
    "Sol tarafta 15 menü ögesinden oluşan sabit responsive dark sidebar yapısı kullanılmalıdır.",
    "Tüm etkileşimli elemanlara (butonlar, girdiler, modal kapatma, menü linkleri, filtreler) 'data-testid' özniteliği eklenmelidir (Örn: data-testid='kantar-yeni-fis-button').",
    "Kantar ekranında Brüt ve Dara girildiğinde Net Kilo ve Toplam Tutar anlık otomatik hesaplanmalıdır.",
    "Günlük Takip ekranında Cari seçildiğinde o cariye ait Bahçeler açılır menüde dinamik olarak filtrelenmelidir.",
    "Raporlar ekranında Excel ve PDF indirme butonları yer almalı, simüle edilmiş veri indirme aksiyonları sunulmalıdır.",
    "Koyu kurumsal tema için koyu gri/obsidyen zemin (#0B0F17) üzerine %2 şeffaf iç çizgi (border-slate-800) ve şık burgundy (#8B1E3F) veya emerald accent vurgular kullanılmalıdır."
  ],
  "UNIVERSAL GUIDELINES FOR MAIN AGENT": {
    "testing_attribute": "Every interactive and key informational element MUST include data-testid in kebab-case format.",
    "animations": "Use framer-motion micro-interactions for sidebar collapse, tab transitions, modal entrances, and toast notifications.",
    "contrast": "Text must meet APCA/WCAG AA standards on dark surfaces. Muted text should be slate-400 (#9CA3AF) minimum.",
    "numbers": "Always format monetary amounts with Turkish Lira symbol '₺' and thousands separators (e.g. 1.250.000 ₺). Use 'kg' and 'Ton' for weights."
  }
